{
  "schema": "walletwall.narration-providers/v1",
  "note": "Bakeoff provider bindings (docs/NARRATION.md). These are evaluation adapters, not the publication voice: scripts/render.ts keeps the fixture voice and config/voice-identity.json still reports the publication binding as NOT_CONFIGURED. Credentials are named by environment variable only; model identities are pinned by revision and sha256; every variant is a complete, closed settings object validated by its adapter.",
  "voiceIdentity": "walletwallaby-v2",
  "accentNote": "Each binding declares the variety its voice actually speaks. The identity asks for en-AU; a provider whose declared accent differs is a documented deviation (recorded per candidate in results.json), never a silent one. The ElevenLabs adapter also checks the voice's own labels through the API.",
  "providers": {
    "elevenlabs": {
      "kind": "remote",
      "role": "Publication target and quality reference. Never cloned, scraped, or used as conditioning for another model.",
      "accent": "en-AU",
      "apiKeyEnv": "ELEVENLABS_API_KEY",
      "voiceIdEnv": "WALLETWALLABY_ELEVENLABS_VOICE_ID",
      "voiceId": "DTLT09E2cxHF0DqjKVbc",
      "variants": {
        "reference": {
          "modelId": "eleven_multilingual_v2",
          "outputFormat": "pcm_44100",
          "stability": 0.5,
          "similarityBoost": 0.75,
          "style": 0,
          "useSpeakerBoost": true,
          "speed": 1,
          "seed": 7,
          "applyTextNormalization": "auto"
        },
        "reference-24k": {
          "modelId": "eleven_multilingual_v2",
          "outputFormat": "pcm_24000",
          "stability": 0.5,
          "similarityBoost": 0.75,
          "style": 0,
          "useSpeakerBoost": true,
          "speed": 1,
          "seed": 7,
          "applyTextNormalization": "auto"
        }
      }
    },
    "magpie-nemo-speech": {
      "kind": "local",
      "role": "Local development and offline fallback. Five fixed American English speakers; no Australian voice exists, so it cannot honour the identity's accent.",
      "accent": "en-US",
      "binaryEnv": "WALLETWALL_NEMO_SPEECH",
      "modelDirEnv": "NEMO_SPEECH_MODEL_DIR",
      "runtime": { "name": "nemo-speech", "version": "0.2.0" },
      "model": {
        "repo": "nvidia/magpie_tts_multilingual_357m",
        "revision": "19806879b16d3f2ccf28fb112b1bcd16a3c7923e",
        "version": "v2607",
        "file": "magpie_tts_multilingual_357m.v2607.f16.gguf",
        "sha256": "30d27551fc4a050e8095139f0185796024493373e83d49443c8ddba33c514e68",
        "tokenizerDir": "tokenizer",
        "tokenizerSha256": "36529a70c72a7cc60e301579eab88a945ba58d915573bf0a2bc8ba0ec5acf036"
      },
      "codec": {
        "repo": "nvidia/nemo-nano-codec-22khz-1.89kbps-21.5fps",
        "revision": "fc00890b604aa2de298d2641ffc6c5f6caf8c4d7",
        "file": "nemo_nano_codec_22khz_1.89kbps_21.5fps.decoder.f16.gguf",
        "sha256": "cc86d36d821a27cdc1d4ef600a3e2b0dabe76e88fcc2a8652d9543134c07ef2d"
      },
      "variantsNote": "cfgScale 2.5, temperature 0.6, topK 80 are NeMo-Speech.cpp 0.2.0's model defaults for this GGUF (verified: explicit values reproduce the default output byte for byte), stated here so provenance never says 'model default'. steps null = the model's own frame limit.",
      "variants": {
        "jason": { "voice": "Jason", "seed": 7, "cfgScale": 2.5, "temperature": 0.6, "topK": 80, "steps": null, "device": "cuda" },
        "leo": { "voice": "Leo", "seed": 7, "cfgScale": 2.5, "temperature": 0.6, "topK": 80, "steps": null, "device": "cuda" },
        "john": { "voice": "John", "seed": 7, "cfgScale": 2.5, "temperature": 0.6, "topK": 80, "steps": null, "device": "cuda" },
        "jason-cool": { "voice": "Jason", "seed": 7, "cfgScale": 2.5, "temperature": 0.4, "topK": 40, "steps": null, "device": "cuda" },
        "aria": { "voice": "Aria", "seed": 7, "cfgScale": 2.5, "temperature": 0.6, "topK": 80, "steps": null, "device": "cuda" },
        "sofia": { "voice": "Sofia", "seed": 7, "cfgScale": 2.5, "temperature": 0.6, "topK": 80, "steps": null, "device": "cuda" }
      }
    },
    "chatterbox-multilingual": {
      "kind": "local",
      "role": "Experimental. The built-in voice is American English; an Australian voice would need owned, licensed reference audio and a separate decision.",
      "accent": "en-US",
      "pythonEnv": "WALLETWALL_CHATTERBOX_PYTHON",
      "entry": "tools/chatterbox/synthesize.py",
      "package": { "name": "chatterbox-tts", "version": "0.1.7", "sourceCommit": "5de7a54aa4e5e2baadb0182dde554908b48b85c2" },
      "model": {

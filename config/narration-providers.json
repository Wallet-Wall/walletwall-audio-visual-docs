          "Cangjie5_TC.json": "7073fd9de919443ae88e0bd2449917a65fe54898a4413ed1edcc4b67f28bce8c",
          "conds.pt": "6552d70568833628ba019c6b03459e77fe71ca197d5c560cef9411bee9d87f4e",
          "grapheme_mtl_merged_expanded_v1.json": "69632f47220a788a52ce2661d096453c5655e9bf25289d89a8d832c46ee07dbf",
          "s3gen.pt": "9b9ff07e60b20c136e2b1b3d7563a24604e8d2c4c267888d1ee929dd0151d2a3",
          "t3_mtl23ls_v3.safetensors": "5abca8321ede76f8e61f1cc0d19aea6c946b28871017ce8726f8a69203f05953",
          "ve.pt": "4b16d836bc598509860f6fa068165a8bb5e9ac84f05582dfcf278a5a372879f1"
        }
      },
      "variants": {
        "default": { "t3Model": "v3", "languageId": "en", "exaggeration": 0.5, "cfgWeight": 0.5, "temperature": 0.8, "repetitionPenalty": 1.2, "minP": 0.05, "topP": 1, "seed": 7, "device": "cuda", "audioPrompt": null, "watermark": "perth" },
        "calm": { "t3Model": "v3", "languageId": "en", "exaggeration": 0.3, "cfgWeight": 0.5, "temperature": 0.6, "repetitionPenalty": 1.2, "minP": 0.05, "topP": 1, "seed": 7, "device": "cuda", "audioPrompt": null, "watermark": "perth" },
        "measured": { "t3Model": "v3", "languageId": "en", "exaggeration": 0.4, "cfgWeight": 0.7, "temperature": 0.7, "repetitionPenalty": 1.2, "minP": 0.05, "topP": 1, "seed": 7, "device": "cuda", "audioPrompt": null, "watermark": "perth" },
        "paced": { "t3Model": "v3", "languageId": "en", "exaggeration": 0.5, "cfgWeight": 0.3, "temperature": 0.8, "repetitionPenalty": 1.2, "minP": 0.05, "topP": 1, "seed": 7, "device": "cuda", "audioPrompt": null, "watermark": "perth" },
        "paced-calm": { "t3Model": "v3", "languageId": "en", "exaggeration": 0.3, "cfgWeight": 0.3, "temperature": 0.6, "repetitionPenalty": 1.2, "minP": 0.05, "topP": 1, "seed": 7, "device": "cuda", "audioPrompt": null, "watermark": "perth" }
      }
    }
  },
  "diagnostics": {
    "asr": {
      "binaryEnv": "WALLETWALL_NEMO_SPEECH",
      "modelDirEnv": "NEMO_SPEECH_MODEL_DIR",
      "runtime": { "name": "nemo-speech", "version": "0.2.0" },
      "model": {
        "repo": "nvidia/parakeet-tdt-0.6b-v3",
        "revision": "541d1f99c6b0c3cd0b11a95167540bb8edefd82b",

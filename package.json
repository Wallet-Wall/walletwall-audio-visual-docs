{
  "name": "walletwall-audio-visual-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic audiovisual documentation for WalletWall: authoritative docs -> typed VideoSpec -> validation -> deterministic Remotion render -> dry-run YouTube manifest.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wallet-Wall/walletwall-audio-visual-docs.git"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "plan": "node scripts/plan.ts",
    "plan:check": "node scripts/plan.ts --check",
    "validate": "node scripts/validate.ts",
    "studio": "node scripts/prepare-assets.ts && remotion studio src/remotion/index.ts --public-dir=dist/public",
    "render": "node scripts/render.ts",
    "render:stills": "node scripts/render.ts --stills",
    "publish:dry-run": "node scripts/publish-dry-run.ts",
    "public:check": "node scripts/public-output-check.ts",
    "publication:proof": "node scripts/publication-proof.ts",
    "publication:verify-receipt": "node scripts/publication-receipt.ts verify",
    "stills:compare": "node scripts/stills-compare.ts",
    "freshness": "node scripts/freshness.ts",
    "contracts:check": "node scripts/contracts-check.ts",
    "rights:check": "node scripts/rights-check.ts",
    "motion:build": "bash motion-intelligence/build-wasm.sh dist/motion-intelligence/motion_intelligence.wasm && node scripts/motion-wasm.ts --write dist/motion-intelligence/motion_intelligence.wasm",
    "motion:check": "bash motion-intelligence/build-wasm.sh dist/motion-intelligence/motion_intelligence.wasm && node scripts/motion-wasm.ts --check dist/motion-intelligence/motion_intelligence.wasm",
    "motion:fixtures": "node scripts/motion-fixtures.ts",
    "motion:bench": "node scripts/motion-bench.ts",
    "blender:build": "node scripts/blender.ts build",
    "blender:render": "node scripts/blender.ts render",
    "blender:review": "node scripts/blender.ts review",
    "blender:contact": "node scripts/blender.ts contact",
    "blender:determinism": "node scripts/blender.ts determinism",
    "blender:proof": "node scripts/blender-proof.ts",
    "blender:qualify-production": "node scripts/blender-qualify.ts",
    "blender:invariants": "node scripts/blender-invariants.ts",
    "pipeline": "node scripts/pipeline.ts",
    "narration": "node scripts/narration.ts",
    "check": "npm run typecheck && npm test && npm run plan:check && npm run validate"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "zod": "4.6.6"
  }
}

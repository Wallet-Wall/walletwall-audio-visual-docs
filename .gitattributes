* text=auto eol=lf
*.png binary
*.jpg binary
*.woff2 binary
# The compiled Rive rig is pinned by the sha256 of its exact bytes.
*.riv binary
# The Motion Intelligence engine is pinned by the sha256 in motion-intelligence/wasm/artifact.json.
*.wasm binary
# The engine's canonical plan fixture is compared byte for byte.
motion-intelligence/tests/fixtures/*.plan.json -text

# Canonical fixtures are byte-identical copies bound to their WalletWall git blob ids:
# never convert line endings, or the blob binding breaks.
fixtures/canonical/** -text
